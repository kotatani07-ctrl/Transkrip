modules = ["nodejs-20", "web", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
DEBUG = "True"
DEFAULT_NAMA_DEKAN = "Nama Dekan"
FEEDER_HOST = "82.41.42.150"
FEEDER_USERNAME = "rroyani887@gmail.com"
ALLOWED_HOSTS = "*"
CSRF_TRUSTED_ORIGINS = "https://*.replit.dev,https://*.replit.app,http://localhost:*"
